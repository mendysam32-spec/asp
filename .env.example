# ============================================
# AI Content Agent - Credentials
# Fill these in AFTER running `python setup_credentials.py`
# ============================================

# --- AI Content Generation (NVIDIA / OpenRouter / OpenAI / Anthropic) ---
# NVIDIA (build.nvidia.com - free credits to start, OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/muse-glimmer-30b
# OpenRouter (openrouter.ai - many free models, OpenAI-compatible)
# e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OpenAI
OPENAI_API_KEY=
# Anthropic (cheaper, recommended to start)
ANTHROPIC_API_KEY=

# --- TikTok (TOP PRIORITY - pays via PayPal) ---
# https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- YouTube (largest payouts) ---
# https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=

# --- X / Twitter ---
# https://developer.x.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Meta (Instagram / Facebook) ---
# https://developers.facebook.com
META_USER_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Numeric Instagram Business/Creator account ID (required for publishing).
# Find it via GET /me?fields=instagram_business_account{id} or the Accounts tab check.
IG_USER_ID=

# --- PayPal (payout destination for creators) ---
# https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # sandbox or live

# --- Agent Settings ---
AUTO_POST=false
HUMAN_APPROVAL=true
DAILY_POST_LIMIT=10

# --- Dashboard remote access (Cloudflare Tunnel, required for phone/laptop) ---
# Set a strong password, then access the dashboard with ?pw=YOUR_PASSWORD
# e.g. https://your-tunnel.trycloudflare.com/?pw=YOUR_PASSWORD
DASHBOARD_PASSWORD=change-me-to-something-long

# --- Alert emails (optional - failure/approval/threshold alerts) ---
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=